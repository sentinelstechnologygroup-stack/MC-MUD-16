{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/district-information",
      "destination": "/__pages/district-information.html"
    },
    {
      "source": "/notice",
      "destination": "/__pages/notice.html"
    },
    {
      "source": "/important-documents",
      "destination": "/__pages/important-documents.html"
    },
    {
      "source": "/elections",
      "destination": "/__pages/elections.html"
    },
    {
      "source": "/meetings",
      "destination": "/__pages/meetings.html"
    },
    {
      "source": "/consultants",
      "destination": "/__pages/consultants.html"
    },
    {
      "source": "/stormwater-management",
      "destination": "/__pages/stormwater-management.html"
    },
    {
      "source": "/accessibility",
      "destination": "/__pages/accessibility.html"
    },
    {
      "source": "/privacy-notice",
      "destination": "/__pages/privacy-notice.html"
    },
    {
      "source": "/terms-of-use",
      "destination": "/__pages/terms-of-use.html"
    },
    {
      "source": "/staff-portal",
      "destination": "/__pages/staff-portal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/staff-portal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
